#!/bin/bash
################################################################################
# calctl - Caldera Control CLI
# 
# Command-line tool for managing Caldera operations in security training labs
# and adversary emulation exercises. Provides a user-friendly interface to the 
# Caldera REST API with built-in workflows for automation.
#
# Version: 1.0.0
# Date: 2026-05-06
################################################################################

set -euo pipefail

# CLI version
CALCTL_VERSION="1.0.0"

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check multiple locations for library file (supports dev, user, and system-wide installs)
if [ -f "$SCRIPT_DIR/caldera_api_lib.sh" ]; then
    # Development mode: library in same directory as executable
    LIB_FILE="$SCRIPT_DIR/caldera_api_lib.sh"
elif [ -f "/usr/local/lib/calctl/caldera_api_lib.sh" ]; then
    # System-wide install: /usr/local/bin/calctl + /usr/local/lib/calctl/
    LIB_FILE="/usr/local/lib/calctl/caldera_api_lib.sh"
elif [ -f "$HOME/.local/lib/calctl/caldera_api_lib.sh" ]; then
    # User install: ~/.local/bin/calctl + ~/.local/lib/calctl/
    LIB_FILE="$HOME/.local/lib/calctl/caldera_api_lib.sh"
else
    # Fallback to same directory (will error later if not found)
    LIB_FILE="$SCRIPT_DIR/caldera_api_lib.sh"
fi

# Config file paths
SYSTEM_CONFIG="/etc/calctl/config"
USER_CONFIG="${HOME}/.config/calctl/config"

# Global flags
VERBOSE=0
QUIET=0
NO_COLOR=0
DRY_RUN=0
FORMAT="table"

# Color codes (will be disabled if NO_COLOR=1)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

################################################################################
# Helper Functions
################################################################################

# Function: Load configuration files
load_config() {
    verbose "Loading configuration..."
    
    # Load system config if exists
    if [ -f "$SYSTEM_CONFIG" ]; then
        verbose "Loading system config: $SYSTEM_CONFIG"
        source "$SYSTEM_CONFIG"
    fi
    
    # Load user config if exists (overrides system)
    if [ -f "$USER_CONFIG" ]; then
        verbose "Loading user config: $USER_CONFIG"
        source "$USER_CONFIG"
    fi
    
    # Environment variables override everything
    if [ -n "${CALDERA_API_URL:-}" ]; then
        verbose "Using CALDERA_API_URL from environment"
        CALDERA_API="$CALDERA_API_URL"
    fi
    
    if [ -n "${CALDERA_API_KEY:-}" ]; then
        verbose "Using CALDERA_API_KEY from environment"
        API_KEY="$CALDERA_API_KEY"
    fi
    
    if [ -n "${ADVERSARY_INVENTORY_PATH:-}" ]; then
        verbose "Using ADVERSARY_INVENTORY_PATH from environment"
        ADVERSARY_INVENTORY="$ADVERSARY_INVENTORY_PATH"
    fi
}

# Function: Print colored output (respects NO_COLOR)
print_color() {
    local color="$1"
    shift
    if [ "$NO_COLOR" -eq 1 ]; then
        echo "$@"
    else
        echo -e "${color}$@${NC}"
    fi
}

# Function: Print verbose output
verbose() {
    if [ "$VERBOSE" -eq 1 ]; then
        print_color "$BLUE" "[VERBOSE] $*"
    fi
}

# Function: Print error
error() {
    print_color "$RED" "[ERROR] $*" >&2
}

# Function: Print warning
warning() {
    print_color "$YELLOW" "[WARNING] $*"
}

# Function: Print success
success() {
    print_color "$GREEN" "[SUCCESS] $*"
}

################################################################################
# Help Functions
################################################################################

