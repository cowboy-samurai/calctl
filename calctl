    echo "calctl version $CALCTL_VERSION"
    echo ""
    echo "Dependencies:"
    echo "  bash:   $(bash --version | head -n1)"
    echo "  curl:   $(curl --version | head -n1)"
    echo "  jq:     $(jq --version 2>/dev/null || echo 'not installed')"
}

